{
  "id": "TOKENIZER",
  "version": 2,
  "name": "Tokenizer",
  "category": "processing",
  "description": "Tokenize text, documents, or chunks with a Hugging Face tokenizer.",
  "inputs": [
    {"name": "text", "data_type": "TEXT", "required": false},
    {"name": "document", "data_type": "DOCUMENT", "required": false},
    {"name": "documents", "data_type": "DOCUMENT_LIST", "required": false},
    {"name": "chunk", "data_type": "CHUNK", "required": false},
    {"name": "chunks", "data_type": "CHUNK_LIST", "required": false}
  ],
  "outputs": [
    {"name": "tokenized", "data_type": "TOKENIZER_OUTPUT", "required": false},
    {"name": "serialized", "data_type": "TEXT", "required": false}
  ],
  "parameters": [
    {"name": "tokenizer_name", "data_type": "TEXT", "default": "bert-base-uncased", "constraints": {"required": true}, "ui_control": "text"},
    {"name": "revision", "data_type": "TEXT", "default": "", "ui_control": "text"},
    {"name": "use_fast", "data_type": "BOOLEAN", "default": true, "ui_control": "toggle"},
    {"name": "add_special_tokens", "data_type": "BOOLEAN", "default": true, "ui_control": "toggle"},
    {"name": "truncation", "data_type": "BOOLEAN", "default": false, "ui_control": "toggle"},
    {"name": "max_length", "data_type": "JSON", "default": 0, "ui_control": "number"},
    {"name": "padding", "data_type": "TEXT", "default": "do_not_pad", "constraints": {"options": ["do_not_pad", "longest", "max_length"]}, "ui_control": "select"},
    {"name": "return_attention_mask", "data_type": "BOOLEAN", "default": false, "ui_control": "toggle"},
    {"name": "return_token_type_ids", "data_type": "BOOLEAN", "default": false, "ui_control": "toggle"},
    {"name": "output_format", "data_type": "TEXT", "default": "json", "constraints": {"options": ["json", "string"]}, "ui_control": "select"}
  ],
  "ui": {"default_width": 360, "accent_color": "#7c8cff", "collapsed_by_default": false},
  "runtime": {"executor_key": "tokenize", "cacheable": true, "deterministic": true, "side_effecting": false}
}
