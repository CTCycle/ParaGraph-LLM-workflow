# Project-specific generated/runtime artifacts
app/resources/artifacts/**
app/resources/models/**
app/resources/tokenizers/**
app/resources/logs/**
app/client/node_modules/
app/client/logs/
app/client/*.local
app/client/debug.log
runtimes/**
!runtimes/cache/
!runtimes/cache/.gitkeep
assets/QA/**

# All disposable runtime, test, tool, browser, and frontend-build output belongs under runtimes/cache.

# Python
*.egg-info/
.venv/
venv/
app/server/uv.lock

# Node / JS
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
package-lock.json
yarn.lock

# IDE / OS
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Misc
# Never commit local environment files; .env.example is intentionally tracked.
.env
**/.env
*.env
*.lock
*.log
*.db
*.sqlite*
*.exe
*.gz
!.gitkeep

# Commit dependency lockfiles for reproducible CI installs.
!app/server/uv.lock
!app/client/package-lock.json
