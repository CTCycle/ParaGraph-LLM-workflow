# Project-specific generated/runtime artifacts
app/resources/artifacts/**
app/resources/models/**
app/resources/tokenizers/**
app/resources/logs/**
app/client/node_modules/
app/client/.vite/
app/client/dist/
app/client/dist-ssr/
app/client/logs/
app/client/*.local
app/client/debug.log
app/client/.eslintcache
app/client/test-results/
app/client/playwright-report/
app/client/coverage/
runtimes/**
!runtimes/cache/
!runtimes/cache/.gitkeep
assets/QA/**

# Legacy cache location retained only so old local artifacts stay ignored while option 7 migrates/removes them.
/assets/cache/

# Test and tool caches plus generated test/build artifacts
/app/tests/cache/*
!/app/tests/cache/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
.coverage
htmlcov/
app/server/uv.lock

# Node / JS
**/node_modules/
**/dist/
**/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
package-lock.json
yarn.lock

# IDE / OS
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Misc
# Never commit local environment files; .env.example is intentionally tracked.
.env
**/.env
*.env
*.lock
*.log
*.db
*.sqlite*
*.exe
*.gz
!.gitkeep

# Commit dependency lockfiles for reproducible CI installs.
!app/server/uv.lock
!app/client/package-lock.json
