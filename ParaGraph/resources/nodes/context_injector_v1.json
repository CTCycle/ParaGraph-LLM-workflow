{
  "id": "CONTEXT_INJECTOR",
  "version": 1,
  "name": "Context Injector",
  "category": "processing",
  "description": "Build model-ready context text from retrieval results.",
  "inputs": [
    {
      "name": "results",
      "data_type": "RETRIEVAL_RESULTS",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "text",
      "data_type": "TEXT",
      "required": true
    }
  ],
  "parameters": [
    {
      "name": "max_context_items",
      "data_type": "JSON",
      "default": 5,
      "constraints": {
        "min": 1,
        "max": 50
      },
      "ui_control": "number",
      "description": "Maximum number of retrieval hits to include."
    },
    {
      "name": "include_citations",
      "data_type": "BOOLEAN",
      "default": true,
      "ui_control": "toggle",
      "description": "Prefix each context entry with a citation index and source."
    },
    {
      "name": "separator",
      "data_type": "TEXT",
      "default": "\n\n",
      "ui_control": "text",
      "description": "Separator inserted between context entries."
    }
  ],
  "ui": {
    "default_width": 360,
    "accent_color": "#6f8cff",
    "collapsed_by_default": false
  },
  "runtime": {
    "executor_key": "context_injector",
    "cacheable": true,
    "deterministic": true,
    "side_effecting": false
  }
}
