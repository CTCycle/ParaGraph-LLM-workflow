{
  "id": "LOAD_TEXT",
  "version": 1,
  "name": "Load Text",
  "category": "serialization",
  "description": "Load text content from the artifacts directory.",
  "inputs": [],
  "outputs": [
    {"name": "text", "data_type": "TEXT", "required": true}
  ],
  "parameters": [
