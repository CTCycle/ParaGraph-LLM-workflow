{
  "id": "BY_STRUCTURE_CHUNKS",
  "version": 1,
  "name": "By Structure Chunks",
  "category": "text_segmentation",
  "description": "Split documents or incoming chunks using structural boundaries such as paragraphs and headings.",
  "inputs": [
    {
      "name": "text",
      "data_type": "TEXT",
      "required": false,
      "accepts_multiple": false,
      "description": "Raw text input to fragment."
    },
    {
      "name": "documents",
      "data_type": "DOCUMENT_LIST",
      "required": false,
      "accepts_multiple": false,
      "description": "Document collection to fragment."
    },
    {
      "name": "chunks",
      "data_type": "CHUNK_LIST",
      "required": false,
      "accepts_multiple": false,
      "description": "Optional upstream chunks for chained text segmentation."
    }
  ],
  "outputs": [
    {
      "name": "chunks",
      "data_type": "CHUNK_LIST",
      "required": true,
      "accepts_multiple": false,
      "description": "Structure-aware chunks."
    }
  ],
  "parameters": [
    {
      "name": "strategy",
      "data_type": "TEXT",
      "default": "paragraph",
      "constraints": {
        "required": true,
        "options": [
          "paragraph",
          "section",
          "heading_and_content"
        ]
      },
      "ui_control": "select",
      "description": "Boundary strategy used for structural splitting."
    },
    {
      "name": "max_chunk_size",
      "data_type": "JSON",
      "default": 0,
      "constraints": {
        "min": 0,
        "max": 100000
      },
      "ui_control": "number",
      "description": "Optional safeguard. Use 0 to disable."
    },
    {
      "name": "chunk_overlap",
      "data_type": "JSON",
      "default": 0,
      "constraints": {
        "min": 0,
        "max": 99999
      },
      "ui_control": "number",
      "description": "Optional overlap used when split_further is triggered."
    },
    {
      "name": "unit",
      "data_type": "TEXT",
      "default": "words",
      "constraints": {
        "required": true,
        "options": [
          "words",
          "characters"
        ]
      },
      "ui_control": "select",
      "description": "Measurement unit for max_chunk_size and overlap."
    },
    {
      "name": "overflow_strategy",
      "data_type": "TEXT",
      "default": "split_further",
      "constraints": {
        "required": true,
        "options": [
          "split_further",
          "emit_as_is"
        ]
      },
      "ui_control": "select",
      "description": "Behavior for chunks exceeding max_chunk_size."
    }
  ],
  "ui": {
    "default_width": 360,
    "accent_color": "#d99128",
    "collapsed_by_default": false
  },
  "runtime": {
    "executor_key": "by_structure_chunks",
    "cacheable": false,
    "deterministic": true,
    "side_effecting": false
  }
}

