{
  "id": "DATABASE_CONNECTION",
  "version": 1,
  "name": "Database Connection",
  "category": "input",
  "description": "Define and validate a reusable read-only database connection manifest for downstream query nodes.",
  "inputs": [],
  "outputs": [
    {"name": "connection", "data_type": "DATABASE_CONNECTION", "required": true}
  ],
  "parameters": [
    {
      "name": "engine",
      "data_type": "TEXT",
      "default": "sqlite",
      "constraints": {"required": true, "options": ["sqlite", "postgresql"]},
      "ui_control": "select",
      "description": "Database engine to target."
    },
    {
      "name": "file_path",
      "data_type": "TEXT",
      "default": "",
      "ui_control": "file",
      "description": "SQLite database file path."
    },
    {
      "name": "host",
      "data_type": "TEXT",
      "default": "",
      "ui_control": "text",
      "description": "PostgreSQL host name."
    },
    {
      "name": "port",
      "data_type": "JSON",
      "default": 5432,
      "constraints": {"min": 1, "max": 65535},
      "ui_control": "number",
      "description": "PostgreSQL port."
    },
    {
      "name": "database_name",
      "data_type": "TEXT",
      "default": "",
      "ui_control": "text",
      "description": "Database name."
    },
    {
      "name": "username",
      "data_type": "TEXT",
      "default": "",
      "ui_control": "text",
      "description": "Database username."
    },
    {
      "name": "password",
      "data_type": "TEXT",
      "default": "",
      "ui_control": "password",
      "description": "Database password."
    },
    {
      "name": "options",
      "data_type": "JSON",
      "default": {},
      "ui_control": "json",
      "description": "Optional JSON object of engine-specific connection options."
    },
    {
      "name": "connect_timeout_s",
      "data_type": "JSON",
      "default": 5,
      "constraints": {"min": 1, "max": 60},
      "ui_control": "number",
      "description": "Connection timeout in seconds."
    }
  ],
  "ui": {"default_width": 360, "accent_color": "#a16207"},
  "runtime": {"executor_key": "database_connection", "cacheable": false, "deterministic": false, "side_effecting": false}
}
