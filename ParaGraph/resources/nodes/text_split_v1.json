{
  "id": "TEXT_SPLIT",
  "version": 1,
  "name": "Text Split",
  "category": "processing",
  "description": "Split text into segments using a delimiter.",
  "inputs": [
    {"name": "text", "data_type": "TEXT", "required": true}
  ],
  "outputs": [
    {"name": "segments", "data_type": "JSON", "required": true}
  ],
  "parameters": [
    {"name": "delimiter", "data_type": "TEXT", "default": "\n", "ui_control": "text", "description": "Delimiter used for splitting."}
  ],
  "ui": {"default_width": 290, "accent_color": "#f59e0b"},
  "runtime": {"executor_key": "text_split", "cacheable": true, "deterministic": true, "side_effecting": false}
}
