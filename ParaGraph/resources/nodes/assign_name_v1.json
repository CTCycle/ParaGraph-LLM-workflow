{
  "id": "ASSIGN_NAME",
  "version": 1,
  "name": "Assign Name",
  "category": "control",
  "description": "Assign any upstream value to a named variable map.",
  "inputs": [
    {
      "name": "value",
      "data_type": "ANY",
      "required": true,
      "accepts_multiple": false,
      "description": "Upstream value to bind."
    }
  ],
  "outputs": [
    {
      "name": "variable",
      "data_type": "JSON",
      "required": true,
      "accepts_multiple": false,
      "description": "Variable object in the form {\"name\": value}."
    }
  ],
  "parameters": [
    {
      "name": "name",
      "data_type": "TEXT",
      "default": "",
      "constraints": {
        "required": true
      },
      "ui_control": "text",
      "description": "Variable name used as the output key."
    }
  ],
  "ui": {
    "default_width": 300,
    "accent_color": "#7bd39c",
    "collapsed_by_default": false
  },
  "runtime": {
    "executor_key": "assign_name",
    "cacheable": true,
    "deterministic": true,
    "side_effecting": false
  }
}
