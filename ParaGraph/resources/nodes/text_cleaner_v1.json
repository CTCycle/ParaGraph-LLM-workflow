{
  "id": "TEXT_CLEANER",
  "version": 1,
  "name": "Text Cleaner",
  "category": "processing",
  "description": "Normalize and clean document text before downstream chunking.",
  "inputs": [
    {
      "name": "documents",
      "data_type": "DOCUMENT_LIST",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "documents",
      "data_type": "DOCUMENT_LIST",
      "required": true
    }
  ],
  "parameters": [
    {
      "name": "strip_html_content",
      "data_type": "BOOLEAN",
      "default": true,
      "ui_control": "toggle",
      "description": "Remove HTML tags from document content before cleaning."
    },
    {
      "name": "collapse_whitespace",
      "data_type": "BOOLEAN",
      "default": true,
      "ui_control": "toggle",
      "description": "Collapse consecutive whitespace into a single space."
    }
  ],
  "ui": {
    "default_width": 340,
    "accent_color": "#6ea3ff",
    "collapsed_by_default": false
  },
  "runtime": {
    "executor_key": "text_cleaner",
    "cacheable": true,
    "deterministic": true,
    "side_effecting": false
  }
}
