{
  "id": "TEMPLATE_FORMAT",
  "version": 1,
  "name": "Template Format",
  "category": "processing",
  "description": "Format text using a simple template.",
  "inputs": [
    {"name": "input", "data_type": "TEXT", "required": true}
  ],
  "outputs": [
    {"name": "text", "data_type": "TEXT", "required": true}
  ],
  "parameters": [
    {"name": "template", "data_type": "TEXT", "default": "{input}", "ui_control": "textarea", "description": "Template string containing {input}."}
  ],
  "ui": {"default_width": 300, "accent_color": "#f59e0b"},
  "runtime": {"executor_key": "template_format", "cacheable": true, "deterministic": true, "side_effecting": false}
}
