{
  "id": "TEMPLATE_FORMAT",
  "version": 1,
  "name": "Template Format",
  "category": "processing",
  "description": "Render text into a configurable template.",
  "inputs": [
    {
      "name": "input",
      "data_type": "TEXT",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "text",
      "data_type": "TEXT",
      "required": true
    }
  ],
  "parameters": [
    {
      "name": "template",
      "data_type": "TEXT",
      "default": "{input}",
      "constraints": {
        "required": true
      },
      "ui_control": "textarea",
      "description": "Template string using {input} placeholder."
    }
  ],
  "ui": {
    "default_width": 320,
    "accent_color": "#8f8fff",
    "collapsed_by_default": false
  },
  "runtime": {
    "executor_key": "template_format",
    "cacheable": true,
    "deterministic": true,
    "side_effecting": false
  }
}
