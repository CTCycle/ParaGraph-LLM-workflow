{
  "id": "PROMPT_TEMPLATE",
  "version": 1,
  "name": "Prompt Template",
  "category": "prompt",
  "description": "Compose prompt text using a template and a single variables input map.",
  "inputs": [
    {
      "name": "variables",
      "data_type": "ANY",
      "required": false,
      "accepts_multiple": true,
      "description": "Variable map input. Connect one or more JSON objects with {name: value} pairs."
    }
  ],
  "outputs": [
    {
      "name": "text",
      "data_type": "TEXT",
      "required": true,
      "accepts_multiple": false,
      "description": "Rendered template text."
    }
  ],
  "parameters": [
    {
      "name": "template",
      "data_type": "TEXT",
      "default": "",
      "constraints": {
        "required": true
      },
      "ui_control": "textarea",
      "description": "Template text with {name} placeholders."
    }
  ],
  "ui": {
    "default_width": 380,
    "accent_color": "#59c6ff",
    "collapsed_by_default": false
  },
  "runtime": {
    "executor_key": "prompt_template",
    "cacheable": false,
    "deterministic": true,
    "side_effecting": false
  }
}
