{
  "id": "BY_DELIMITER_CHUNKS",
  "version": 1,
  "name": "By Delimiter Chunks",
  "category": "fragmentation",
  "description": "Split documents or incoming chunks using explicit delimiters.",
  "inputs": [
    {
      "name": "documents",
      "data_type": "DOCUMENT_LIST",
      "required": false,
      "accepts_multiple": false,
      "description": "Document collection to fragment."
    },
    {
      "name": "chunks",
      "data_type": "CHUNK_LIST",
      "required": false,
      "accepts_multiple": false,
      "description": "Optional upstream chunks for chained fragmentation."
    }
  ],
  "outputs": [
    {
      "name": "chunks",
      "data_type": "CHUNK_LIST",
      "required": true,
      "accepts_multiple": false,
      "description": "Delimiter-based chunks."
    }
  ],
  "parameters": [
    {
      "name": "delimiter",
      "data_type": "TEXT",
      "default": "newline",
      "constraints": {
        "required": true
      },
      "ui_control": "text",
      "description": "Delimiter text or preset key (newline, double_newline, comma, period, semicolon, tab, html_br, html_paragraph)."
    },
    {
      "name": "keep_delimiter",
      "data_type": "BOOLEAN",
      "default": false,
      "ui_control": "toggle",
      "description": "Keep the delimiter attached to emitted chunks."
    },
    {
      "name": "drop_empty",
      "data_type": "BOOLEAN",
      "default": true,
      "ui_control": "toggle",
      "description": "Drop empty chunks after splitting."
    },
    {
      "name": "max_chunk_size",
      "data_type": "JSON",
      "default": 0,
      "constraints": {
        "min": 0,
        "max": 100000
      },
      "ui_control": "number",
      "description": "Optional safeguard. Use 0 to disable."
    },
    {
      "name": "overflow_strategy",
      "data_type": "TEXT",
      "default": "split_further",
      "constraints": {
        "required": true,
        "options": [
          "split_further",
          "discard",
          "emit_as_is"
        ]
      },
      "ui_control": "select",
      "description": "Behavior for chunks exceeding max_chunk_size."
    }
  ],
  "ui": {
    "default_width": 360,
    "accent_color": "#d99128",
    "collapsed_by_default": false
  },
  "runtime": {
    "executor_key": "by_delimiter_chunks",
    "cacheable": false,
    "deterministic": true,
    "side_effecting": false
  }
}
