{
  "id": "API_CALL",
  "version": 1,
  "name": "API Call",
  "category": "web",
  "description": "Call a REST endpoint and return text/json plus normalized response metadata.",
  "inputs": [
    {
      "name": "url",
      "data_type": "TEXT",
      "required": false,
      "description": "Optional URL override."
    },
    {
      "name": "body",
      "data_type": "JSON",
      "required": false,
      "description": "Optional JSON request body."
    },
    {
      "name": "headers_in",
      "data_type": "JSON",
      "required": false,
      "description": "Optional headers override object."
    },
    {
      "name": "params_in",
      "data_type": "JSON",
      "required": false,
      "description": "Optional query params override object."
    }
  ],
  "outputs": [
    {
      "name": "text",
      "data_type": "TEXT",
      "required": true
    },
    {
      "name": "json",
      "data_type": "JSON",
      "required": true
    },
    {
      "name": "response",
      "data_type": "JSON",
      "required": true
    }
  ],
  "parameters": [
    {
      "name": "url",
      "data_type": "TEXT",
      "default": "",
      "constraints": {
        "required": true
      },
      "ui_control": "text",
      "description": "Endpoint URL."
    },
    {
      "name": "method",
      "data_type": "TEXT",
      "default": "GET",
      "constraints": {
        "options": [
          "GET",
          "POST"
        ]
      },
      "ui_control": "select",
      "description": "HTTP method."
    },
    {
      "name": "headers",
      "data_type": "JSON",
      "default": {},
      "ui_control": "json",
      "description": "HTTP headers object."
    },
    {
      "name": "params",
      "data_type": "JSON",
      "default": {},
      "ui_control": "json",
      "description": "Query params object."
    },
    {
      "name": "timeout_s",
      "data_type": "TEXT",
      "default": "15",
      "ui_control": "number",
      "constraints": {
        "min": 0.1,
        "max": 300
      },
      "description": "Request timeout in seconds."
    },
    {
      "name": "follow_redirects",
      "data_type": "BOOLEAN",
      "default": true,
      "ui_control": "toggle"
    },
    {
      "name": "auth_mode",
      "data_type": "TEXT",
      "default": "none",
      "constraints": {
        "options": [
          "none",
          "bearer",
          "basic"
        ]
      },
      "ui_control": "select"
    },
    {
      "name": "token",
      "data_type": "TEXT",
      "default": "",
      "ui_control": "password"
    },
    {
      "name": "username",
      "data_type": "TEXT",
      "default": "",
      "ui_control": "text"
    },
    {
      "name": "password",
      "data_type": "TEXT",
      "default": "",
      "ui_control": "password"
    },
    {
      "name": "raise_for_status",
      "data_type": "BOOLEAN",
      "default": false,
      "ui_control": "toggle"
    },
    {
      "name": "response_mode",
      "data_type": "TEXT",
      "default": "auto",
      "constraints": {
        "options": [
          "auto",
          "json",
          "text"
        ]
      },
      "ui_control": "select"
    }
  ],
  "ui": {
    "default_width": 360,
    "accent_color": "#2f80ed",
    "collapsed_by_default": false
  },
  "runtime": {
    "executor_key": "plugin",
    "cacheable": false,
    "deterministic": false,
    "side_effecting": true,
    "plugin": {
      "script_path": "plugins/api_call_v1.py",
      "entrypoint": "execute"
    }
  }
}
