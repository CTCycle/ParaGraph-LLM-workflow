{
  "id": "CLOUD_LLM_CHAT",
  "version": 1,
  "name": "Cloud LLM Chat",
  "category": "model",
  "description": "Chat with an OpenAI, Gemini, or Claude model and return plain text.",
  "inputs": [
    {"name": "user_prompt", "data_type": "TEXT", "required": false},
    {"name": "system_prompt", "data_type": "TEXT", "required": false},
    {"name": "image", "data_type": "IMAGE", "required": false}
  ],
  "outputs": [
    {"name": "response", "data_type": "TEXT", "required": true}
  ],
  "parameters": [
    {
      "name": "provider",
      "data_type": "TEXT",
      "default": "openai",
      "constraints": {"required": true, "options": ["openai", "gemini", "claude"]},
      "ui_control": "select",
      "description": "Cloud provider."
    },
    {
      "name": "model_name",
      "data_type": "TEXT",
      "default": "",
      "constraints": {"required": true, "provider_source": "cloud"},
      "ui_control": "select",
      "description": "Provider model identifier."
    },
    {
      "name": "max_tokens",
      "data_type": "JSON",
      "default": 512,
      "constraints": {"min": 1},
      "ui_control": "number",
      "description": "Maximum output token count."
    },
    {
      "name": "use_reasoning",
      "data_type": "BOOLEAN",
      "default": false,
      "ui_control": "toggle",
      "description": "Enable provider-specific reasoning behavior when available."
    }
  ],
  "ui": {"default_width": 360, "accent_color": "#818cf8", "collapsed_by_default": false},
  "runtime": {"executor_key": "cloud_llm_chat", "cacheable": false, "deterministic": false, "side_effecting": false}
}
