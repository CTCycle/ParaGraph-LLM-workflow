{
  "id": "SQL_FILE_DATABASE",
  "version": 1,
  "name": "Embedded SQL Database",
  "category": "control",
  "description": "Configure an embedded SQL dataset and expose a typed controller handle for downstream SQL nodes.",
  "inputs": [],
  "outputs": [],
  "controllers": [
    {
      "name": "connection",
      "data_type": "DATABASE_CONNECTION",
      "required": false,
      "accepts_multiple": true,
      "description": "Read-only SQL file connection handle for downstream SQL nodes.",
      "scope": "source"
    }
  ],
  "parameters": [
    {
      "name": "db_engine",
      "data_type": "TEXT",
      "default": "sqlite",
      "constraints": {
        "required": true,
        "options": [
          "sqlite"
        ]
      },
      "ui_control": "select",
      "description": "File database engine."
    },
    {
      "name": "db_path",
      "data_type": "TEXT",
      "default": "",
      "constraints": {
        "required": true
      },
      "ui_control": "file",
      "description": "Path to the database file."
    },
    {
      "name": "db_port",
      "data_type": "JSON",
      "default": 5432,
      "constraints": {
        "min": 1,
        "max": 65535
      },
      "ui_control": "number",
      "description": "Reserved for cross-engine compatibility."
    },
    {
      "name": "db_name",
      "data_type": "TEXT",
      "default": "paragraph",
      "ui_control": "text",
      "description": "Logical dataset name."
    },
    {
      "name": "db_user",
      "data_type": "TEXT",
      "default": "postgres",
      "ui_control": "text",
      "description": "Reserved for cross-engine compatibility."
    },
    {
      "name": "db_password",
      "data_type": "TEXT",
      "default": "change_me",
      "ui_control": "password",
      "description": "Reserved for cross-engine compatibility."
    },
    {
      "name": "db_ssl",
      "data_type": "BOOLEAN",
      "default": false,
      "ui_control": "toggle",
      "description": "Reserved for cross-engine compatibility."
    },
    {
      "name": "db_ssl_ca",
      "data_type": "TEXT",
      "default": "",
      "ui_control": "file",
      "description": "Reserved for cross-engine compatibility."
    },
    {
      "name": "db_connect_timeout",
      "data_type": "JSON",
      "default": 30,
      "constraints": {
        "min": 1,
        "max": 120
      },
      "ui_control": "number",
      "description": "Connection timeout in seconds."
    }
  ],
  "ui": {
    "default_width": 360,
    "accent_color": "#2877c7",
    "collapsed_by_default": false
  },
  "runtime": {
    "executor_key": "sql_file_database",
    "cacheable": false,
    "deterministic": false,
    "side_effecting": false
  }
}
