{
  "id": "WEB_SCRAPER",
  "version": 1,
  "name": "Web Scraper",
  "category": "input",
  "description": "Fetch an HTML page and convert it into normalized document text for downstream RAG processing.",
  "inputs": [],
  "outputs": [
    {"name": "documents", "data_type": "DOCUMENT_LIST", "required": true}
  ],
  "parameters": [
    {
      "name": "url",
      "data_type": "TEXT",
      "default": "",
      "constraints": {"required": true},
      "ui_control": "text",
      "description": "HTTP or HTTPS URL to fetch."
    },
    {
      "name": "timeout_s",
      "data_type": "JSON",
      "default": 15,
      "constraints": {"min": 1, "max": 120},
      "ui_control": "number",
      "description": "Request timeout in seconds."
    },
    {
      "name": "strip_html_content",
      "data_type": "BOOLEAN",
      "default": true,
      "ui_control": "toggle",
      "description": "Convert the fetched page to plain text before emitting it."
    }
  ],
  "ui": {"default_width": 320, "accent_color": "#0f766e"},
  "runtime": {"executor_key": "web_scraper", "cacheable": false, "deterministic": false, "side_effecting": false}
}
