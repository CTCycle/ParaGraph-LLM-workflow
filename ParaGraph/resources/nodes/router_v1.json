{
  "id": "ROUTER",
  "version": 1,
  "name": "Router",
  "category": "control",
  "description": "Route a value to matched or unmatched output based on a parameter.",
  "inputs": [
    {"name": "value", "data_type": "ANY", "required": true}
  ],
  "outputs": [
    {"name": "matched", "data_type": "ANY", "required": false},
    {"name": "unmatched", "data_type": "ANY", "required": false}
  ],
  "parameters": [
    {"name": "expected_value", "data_type": "TEXT", "default": "", "ui_control": "text", "description": "Value to compare against."}
  ],
  "ui": {"default_width": 290, "accent_color": "#a78bfa"},
  "runtime": {"executor_key": "router", "cacheable": true, "deterministic": true, "side_effecting": false}
}
