{
  "id": "LLM_STRUCTURED",
  "version": 1,
  "name": "LLM Structured",
  "category": "model",
  "description": "Run a structured generation with a typed model handle selected by a provider node and return validated JSON.",
  "inputs": [
    {
      "name": "model",
      "data_type": "MODEL_HANDLE",
      "required": false
    },
    {
      "name": "user_prompt",
      "data_type": "TEXT",
      "required": false
    },
    {
      "name": "system_prompt",
      "data_type": "TEXT",
      "required": false
    },
    {
      "name": "image",
      "data_type": "IMAGE",
      "required": false
    }
  ],
  "outputs": [
    {
      "name": "result",
      "data_type": "JSON",
      "required": true
    }
  ],
  "parameters": [
    {
      "name": "context_window",
      "data_type": "JSON",
      "default": 0,
      "constraints": {
        "min": 0
      },
      "ui_control": "number",
      "description": "Context window size. Use 0 for provider-managed context."
    },
    {
      "name": "max_tokens",
      "data_type": "JSON",
      "default": 512,
      "constraints": {
        "min": 1
      },
      "ui_control": "number",
      "description": "Maximum output token count."
    },
    {
      "name": "use_reasoning",
      "data_type": "BOOLEAN",
      "default": false,
      "ui_control": "toggle",
      "description": "Enable reasoning-oriented execution when the selected model supports it."
    },
    {
      "name": "response_schema",
      "data_type": "JSON",
      "default": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "constraints": {
        "required": true
      },
      "ui_control": "json",
      "description": "JSON Schema used to validate the structured response."
    }
  ],
  "ui": {
    "default_width": 380,
    "accent_color": "#4467e6",
    "collapsed_by_default": false
  },
  "runtime": {
    "executor_key": "llm_structured",
    "cacheable": false,
    "deterministic": false,
    "side_effecting": false
  }
}
