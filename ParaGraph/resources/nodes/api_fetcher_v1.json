{
  "id": "API_FETCHER",
  "version": 1,
  "name": "API Fetcher",
  "category": "input",
  "description": "Fetch text or JSON from an HTTP endpoint and emit it as a normalized document list.",
  "inputs": [],
  "outputs": [
    {"name": "documents", "data_type": "DOCUMENT_LIST", "required": true}
  ],
  "parameters": [
    {
      "name": "url",
      "data_type": "TEXT",
      "default": "",
      "constraints": {"required": true},
      "ui_control": "text",
      "description": "HTTP or HTTPS API endpoint to fetch."
    },
    {
      "name": "timeout_s",
      "data_type": "JSON",
      "default": 15,
      "constraints": {"min": 1, "max": 120},
      "ui_control": "number",
      "description": "Request timeout in seconds."
    },
    {
      "name": "response_selector",
      "data_type": "TEXT",
      "default": "",
      "ui_control": "text",
      "description": "Optional dotted selector for extracting a nested JSON field."
    }
  ],
  "ui": {"default_width": 320, "accent_color": "#0f766e"},
  "runtime": {"executor_key": "api_fetcher", "cacheable": false, "deterministic": false, "side_effecting": false}
}
