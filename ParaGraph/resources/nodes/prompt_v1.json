      "ui_control": "textarea",
      "description": "Prompt text emitted to downstream nodes."
    }
  ],
  "ui": {
    "default_width": 320,
    "accent_color": "#59c6ff",
    "collapsed_by_default": false
  },
  "runtime": {
    "executor_key": "prompt",
    "cacheable": true,
    "deterministic": true,
    "side_effecting": false
  }
}
