{
  "id": "PROMPT",
  "version": 1,
  "name": "Prompt",
  "category": "prompt",
  "description": "Provide generic prompt text to the workflow graph.",
  "inputs": [],
  "outputs": [
    {
      "name": "text",
      "data_type": "TEXT",
      "required": true
    }
  ],
  "parameters": [
    {
      "name": "prompt_text",
      "data_type": "TEXT",
      "default": "",
      "constraints": {
