{
  "id": "HUGGINGFACE_LLM_CHAT",
  "version": 1,
  "name": "HuggingFace LLM Chat",
  "category": "model",
  "description": "Chat with a locally served HuggingFace model and return plain text.",
  "inputs": [
    {"name": "user_prompt", "data_type": "TEXT", "required": false},
    {"name": "system_prompt", "data_type": "TEXT", "required": false},
    {"name": "image", "data_type": "IMAGE", "required": false}
  ],
  "outputs": [
    {"name": "response", "data_type": "TEXT", "required": true}
  ],
  "parameters": [
    {
      "name": "model_name",
      "data_type": "TEXT",
      "default": "",
      "constraints": {"required": true, "provider_source": "huggingface"},
      "ui_control": "select",
      "description": "HuggingFace model identifier."
    },
    {
      "name": "context_window",
      "data_type": "JSON",
      "default": 0,
      "constraints": {"min": 0},
      "ui_control": "number",
      "description": "Context window size. Use 0 for provider-managed context."
    },
    {
      "name": "max_tokens",
      "data_type": "JSON",
      "default": 512,
      "constraints": {"min": 1},
      "ui_control": "number",
      "description": "Maximum output token count."
    },
    {
      "name": "use_reasoning",
      "data_type": "BOOLEAN",
      "default": false,
      "ui_control": "toggle",
      "description": "Enable reasoning-oriented execution when the model supports it."
    }
  ],
  "ui": {"default_width": 360, "accent_color": "#f59e0b", "collapsed_by_default": false},
  "runtime": {"executor_key": "huggingface_llm_chat", "cacheable": false, "deterministic": false, "side_effecting": false}
}
