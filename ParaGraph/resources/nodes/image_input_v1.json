{
  "id": "IMAGE_INPUT",
  "version": 1,
  "name": "Image Input",
  "category": "input",
  "description": "Provide an image file path to the workflow graph.",
  "inputs": [],
  "outputs": [
    {"name": "image", "data_type": "IMAGE", "required": true}
  ],
  "parameters": [
    {
      "name": "file_path",
      "data_type": "TEXT",
      "default": "",
      "constraints": {"required": true},
      "ui_control": "text",
      "description": "Path to the source image file."
    }
  ],
  "ui": {"default_width": 300, "accent_color": "#78dca0"},
  "runtime": {"executor_key": "image_input", "cacheable": true, "deterministic": true, "side_effecting": false}
}
