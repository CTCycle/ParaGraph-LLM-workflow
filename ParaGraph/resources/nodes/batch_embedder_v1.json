{
  "id": "BATCH_EMBEDDER",
  "version": 1,
  "name": "Batch Embedder",
  "category": "model",
  "description": "Generate embeddings for document chunks and emit vector points for vector-store indexing.",
  "inputs": [
    {"name": "chunks", "data_type": "CHUNK_LIST", "required": true}
  ],
  "outputs": [
    {"name": "points", "data_type": "VECTOR_POINT_LIST", "required": true}
  ],
  "parameters": [
    {
      "name": "provider",
      "data_type": "TEXT",
      "default": "ollama",
      "constraints": {"options": ["ollama", "openai", "gemini", "huggingface"]},
      "ui_control": "select",
      "description": "Embedding provider."
    },
    {
      "name": "model_name",
      "data_type": "TEXT",
      "default": "nomic-embed-text",
      "ui_control": "text",
      "description": "Embedding model identifier."
    },
    {
      "name": "batch_size",
      "data_type": "JSON",
      "default": 16,
      "constraints": {"min": 1, "max": 128},
      "ui_control": "number",
      "description": "Requested batch size for embedding work."
    },
    {
      "name": "dimensions",
      "data_type": "JSON",
      "default": 0,
      "constraints": {"min": 0, "max": 8192},
      "ui_control": "number",
      "description": "Optional embedding dimension override. Use 0 to keep provider defaults."
    },
    {
      "name": "normalize",
      "data_type": "BOOLEAN",
      "default": true,
      "ui_control": "toggle",
      "description": "L2-normalize vectors before writing them to storage."
    },
    {
      "name": "max_retries",
      "data_type": "JSON",
      "default": 1,
      "constraints": {"min": 0, "max": 5},
      "ui_control": "number",
      "description": "Retries per chunk if embedding generation fails."
    }
  ],
  "ui": {"default_width": 340, "accent_color": "#2563eb"},
  "runtime": {"executor_key": "batch_embedder", "cacheable": false, "deterministic": false, "side_effecting": false}
}
