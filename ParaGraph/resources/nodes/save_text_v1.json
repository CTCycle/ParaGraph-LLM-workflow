{
  "id": "SAVE_TEXT",
  "version": 1,
  "name": "Save Text",
  "category": "serialization",
  "description": "Save incoming text, documents, or chunks to one file or multiple files and return artifact metadata.",
  "inputs": [
    {
      "name": "text",
      "data_type": "TEXT",
      "required": false
    },
    {
      "name": "documents",
      "data_type": "DOCUMENT_LIST",
      "required": false
    },
    {
      "name": "chunks",
      "data_type": "CHUNK_LIST",
      "required": false
    }
  ],
  "outputs": [
    {
      "name": "artifact",
      "data_type": "JSON",
      "required": true
    }
  ],
  "parameters": [
    {
      "name": "output_path",
      "data_type": "TEXT",
      "default": "",
      "constraints": {
        "required": true
      },
      "ui_control": "text",
      "description": "Destination file path (single file) or folder path (multiple files)."
    },
    {
      "name": "separate_files",
      "data_type": "BOOLEAN",
      "default": false,
      "ui_control": "toggle",
      "description": "When true, save one file per document/chunk item in the destination folder."
    },
    {
      "name": "extension",
      "data_type": "TEXT",
      "default": ".txt",
      "constraints": {
        "required": true,
        "options": [
          ".txt",
          ".md",
          ".doc",
          ".pdf"
        ]
      },
      "ui_control": "select",
      "description": "File extension used for generated files."
    }
  ],
  "ui": {
    "default_width": 320,
    "accent_color": "#4f9d7d",
    "collapsed_by_default": false
  },
  "runtime": {
    "executor_key": "save_text",
    "cacheable": false,
    "deterministic": true,
    "side_effecting": true
  }
}
