{
  "id": "SAVE_TEXT",
  "version": 1,
  "name": "Save Text",
  "category": "serialization",
  "description": "Write text to a local file path and return artifact metadata.",
  "inputs": [
    {
      "name": "text",
      "data_type": "TEXT",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "artifact",
      "data_type": "JSON",
      "required": true
    }
  ],
  "parameters": [
    {
      "name": "storage_path",
      "data_type": "TEXT",
      "default": "",
      "constraints": {
        "required": true
      },
      "ui_control": "file",
      "description": "Destination file path for the text payload."
    }
  ],
  "ui": {
    "default_width": 320,
    "accent_color": "#4f9d7d",
    "collapsed_by_default": false
  },
  "runtime": {
    "executor_key": "save_text",
    "cacheable": false,
    "deterministic": true,
    "side_effecting": true
  }
}
