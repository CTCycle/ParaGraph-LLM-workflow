{
  "id": "LLM_STRUCTURED",
  "version": 1,
  "name": "LLM Structured Output",
  "category": "model",
  "description": "Run structured generation or structured extraction with JSON Schema, inferred model, or pasted Pydantic source validation.",
  "inputs": [
    {
      "name": "user_prompt",
      "data_type": "TEXT",
      "required": false
    },
    {
      "name": "system_prompt",
      "data_type": "TEXT",
      "required": false
    },
    {
      "name": "image",
      "data_type": "IMAGE",
      "required": false
    }
  ],
  "outputs": [
    {
      "name": "result",
      "data_type": "JSON",
      "required": true
    },
    {
      "name": "schema",
      "accepts_multiple": false,
      "required": false,
      "description": "Validation schema.",
      "data_type": "JSON"
    },
    {
      "name": "valid",
      "accepts_multiple": false,
      "required": false,
      "description": "Validation success.",
      "data_type": "BOOLEAN"
    },
    {
      "name": "errors",
      "accepts_multiple": false,
      "required": false,
      "description": "Validation errors.",
      "data_type": "JSON"
    }
  ],
  "controllers": [
    {
      "name": "model",
      "data_type": "MODEL_HANDLE",
      "required": true,
      "accepts_multiple": false,
      "description": "Required model controller provided by a MODEL_PROVIDER node.",
      "scope": "target"
    },
    {
      "name": "history",
      "data_type": "CHAT_HISTORY_HANDLE",
      "required": false,
      "accepts_multiple": false,
      "description": "Optional chat history handle controller provided by a chat history node.",
      "scope": "target"
    }
  ],
  "parameters": [
    {
      "name": "context_window",
      "data_type": "JSON",
      "default": 0,
      "constraints": {
        "min": 0
      },
      "ui_control": "number",
      "description": "Context window size. Use 0 for provider-managed context."
    },
    {
      "name": "max_tokens",
      "data_type": "JSON",
      "default": 512,
      "constraints": {
        "min": 1
      },
      "ui_control": "number",
      "description": "Maximum output token count."
    },
    {
      "name": "use_reasoning",
      "data_type": "BOOLEAN",
      "default": false,
      "ui_control": "toggle",
      "description": "Enable reasoning-oriented execution when the selected model supports it."
    },
    {
      "name": "response_schema",
      "data_type": "JSON",
      "default": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "constraints": {
        "required": true
      },
      "ui_control": "json",
      "description": "JSON Schema used to validate the structured response."
    },
    {
      "data_type": "TEXT",
      "ui_control": "select",
      "constraints": {
        "options": [
          "schema",
          "auto",
          "pydantic_source"
        ]
      },
      "default": "schema",
      "name": "model_mode",
      "description": "Structured validation mode."
    },
    {
      "data_type": "TEXT",
      "ui_control": "textarea",
      "constraints": {},
      "default": "",
      "name": "model_source",
      "description": "Pasted Pydantic model source for pydantic_source mode."
    }
  ],
  "ui": {
    "default_width": 380,
    "accent_color": "#4467e6",
    "collapsed_by_default": false
  },
  "runtime": {
    "executor_key": "llm_structured",
    "cacheable": false,
    "deterministic": false,
    "side_effecting": false
  }
}
