{
  "id": "HTTP_POST",
  "version": 1,
  "name": "HTTP POST",
  "category": "web",
  "description": "Execute a bounded SSRF-protected POST request through the shared secure transport.",
  "inputs": [
    {"name": "url", "data_type": "TEXT", "required": false},
    {"name": "body", "data_type": "ANY", "required": false}
  ],
  "outputs": [
    {"name": "response", "data_type": "JSON", "required": true},
    {"name": "json", "data_type": "JSON", "required": false},
    {"name": "text", "data_type": "TEXT", "required": false}
  ],
  "parameters": [
    {"name": "url", "data_type": "TEXT", "default": "", "ui_control": "text"},
    {"name": "headers", "data_type": "JSON", "default": {}, "ui_control": "json"},
    {"name": "query", "data_type": "JSON", "default": {}, "ui_control": "json"},
    {"name": "body_mode", "data_type": "TEXT", "default": "none", "constraints": {"options": ["none", "json", "text", "form", "multipart", "file"]}, "ui_control": "select"},
    {"name": "json_body", "data_type": "JSON", "default": null, "ui_control": "json"},
    {"name": "text_body", "data_type": "TEXT", "default": "", "ui_control": "textarea"},
    {"name": "form_body", "data_type": "JSON", "default": {}, "ui_control": "json"},
    {"name": "multipart_fields", "data_type": "JSON", "default": {}, "ui_control": "json"},
    {"name": "upload_path", "data_type": "TEXT", "default": "", "ui_control": "file"},
    {"name": "response_mode", "data_type": "TEXT", "default": "auto", "constraints": {"options": ["auto", "json", "text", "binary", "file"]}, "ui_control": "select"},
    {"name": "download_path", "data_type": "TEXT", "default": "", "ui_control": "file"},
    {"name": "accepted_statuses", "data_type": "JSON", "default": ["200-299"], "ui_control": "json"},
    {"name": "credential_profile", "data_type": "TEXT", "default": "", "ui_control": "text"},
    {"name": "credential_provider", "data_type": "TEXT", "default": "http", "ui_control": "text"},
    {"name": "auth_mode", "data_type": "TEXT", "default": "none", "constraints": {"options": ["none", "bearer", "api_key", "basic"]}, "ui_control": "select"},
    {"name": "api_key_header", "data_type": "TEXT", "default": "X-API-Key", "ui_control": "text"},
    {"name": "username", "data_type": "TEXT", "default": "", "ui_control": "text"},
    {"name": "connect_timeout", "data_type": "JSON", "default": 10.0, "ui_control": "number"},
    {"name": "read_timeout", "data_type": "JSON", "default": 30.0, "ui_control": "number"},
    {"name": "write_timeout", "data_type": "JSON", "default": 30.0, "ui_control": "number"},
    {"name": "pool_timeout", "data_type": "JSON", "default": 10.0, "ui_control": "number"},
    {"name": "overall_timeout", "data_type": "JSON", "default": 60.0, "ui_control": "number"},
    {"name": "max_response_bytes", "data_type": "JSON", "default": 2000000, "ui_control": "number"},
    {"name": "max_download_bytes", "data_type": "JSON", "default": 100000000, "ui_control": "number"},
    {"name": "max_redirects", "data_type": "JSON", "default": 0, "ui_control": "number"},
    {"name": "allow_https_downgrade", "data_type": "BOOLEAN", "default": false, "ui_control": "checkbox"},
    {"name": "max_attempts", "data_type": "JSON", "default": 1, "ui_control": "number"},
    {"name": "backoff_seconds", "data_type": "JSON", "default": 0.25, "ui_control": "number"},
    {"name": "max_retry_delay", "data_type": "JSON", "default": 60.0, "ui_control": "number"},
    {"name": "retry_statuses", "data_type": "JSON", "default": [429, 502, 503, 504], "ui_control": "json"},
    {"name": "retry_unsafe", "data_type": "BOOLEAN", "default": false, "ui_control": "checkbox"},
    {"name": "idempotency_key", "data_type": "TEXT", "default": "", "ui_control": "text"}
  ],
  "ui": {"default_width": 360, "accent_color": "#ff9f68", "collapsed_by_default": false},
  "runtime": {"executor_key": "http_post", "cacheable": false, "deterministic": false, "side_effecting": true, "idempotent": false}
}
