{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ParaGraph Desktop",
  "version": "1.0.0",
  "identifier": "com.paragraph.desktop",
  "build": {
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../client/dist",
    "devUrl": "about:blank"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ParaGraph Desktop",
        "url": "about:blank",
        "width": 1440,
        "height": 920,
        "center": true,
        "resizable": true
      }
    ],
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "./r/runtime": "runtime"
    }
  }
}
