# ==============================================================================
# Backend Server
# ==============================================================================
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=5002
RELOAD=false

# ==============================================================================
# Frontend Server
# ==============================================================================
UI_HOST=127.0.0.1
UI_PORT=8002
VITE_API_BASE_URL=/api

# Optional cross-origin browser access. Leave origins blank for same-origin use.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type

# Shared Resource Storage
# Leave blank to use data. Set an absolute path or a path relative to the repository root to relocate all resource data, including the embedded SQLite database.
PARAGRAPH_RESOURCES_DIR=

# ==============================================================================
# Python / ML Runtime
# ==============================================================================
MPLBACKEND=Agg
KERAS_BACKEND=torch

# ==============================================================================
# LLM Runtime
# ==============================================================================
LLM_TIMEOUT_S=30
